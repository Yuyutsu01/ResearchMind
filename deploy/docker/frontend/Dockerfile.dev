# Use Node 22 Alpine to support modern Vite 8+ requirements
FROM node:22-alpine

WORKDIR /app

# Copy package.json and lock file
COPY package*.json ./

# Install dependencies
RUN npm install

# We do not copy the source code because we will volume mount it for HMR
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
